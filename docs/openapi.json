    "/v1/imports/{id}/download": {
      "get": {
        "operationId": "download",
        "description": "Owner only; completed results only. Cells quoted and spreadsheet formula prefixes neutralized. No public result URL.",
        "security": [
          {
            "apiBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "accepted",
                "errors"
              ]
            },
            "description": "Export kind"
          }
        ],
        "responses": {
