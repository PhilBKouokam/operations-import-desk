                    "destination_code",
                    "scheduled_date",
                    "weight_kg",
                    "carrier_code"
                  ]
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "code": {
                        "type": "string"
                      },
                      "message": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "field",
                      "code",
                      "message"
                    ]
                  }
                }
              },
              "required": [
                "recordNumber",
                "values",
                "errors"
              ]
            }
          },
          "total": {
            "type": "integer"
          },
          "nextOffset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
