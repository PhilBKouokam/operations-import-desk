                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "code",
                  "safeMessage",
                  "retryable",
                  "occurredAt"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "time": {
                  "type": "string",
                  "format": "date-time"
