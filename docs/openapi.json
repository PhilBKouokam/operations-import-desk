  "components": {
    "securitySchemes": {
      "apiBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OIDC-issued API access token (RS256, exact issuer/audience, Bearer typ, exp/iat/sub). Never an ID token. Browser uses Authorization Code + PKCE S256 with public odi-web client."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Me": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "operator",
              "viewer"
            ]
          }
        },
        "required": [
          "subject",
          "role"
        ]
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "maximum": 262144
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "COMPLETED",
              "COMPLETED_WITH_ERRORS",
              "FAILED"
            ]
          },
          "run": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "counts": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "totalRows": {
                    "type": "integer"
                  },
                  "validCount": {
                    "type": "integer"
                  },
                  "rejectedCount": {
                    "type": "integer"
                  }
                },
                "required": [
                  "totalRows",
                  "validCount",
                  "rejectedCount"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "canRetry": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "filename",
          "byteSize",
          "state",
          "run",
          "attempt",
          "createdAt",
          "updatedAt",
          "counts",
          "canRetry"
        ]
      },
      "Detail": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "filename": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "maximum": 262144
          },
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "PROCESSING",
              "COMPLETED",
              "COMPLETED_WITH_ERRORS",
              "FAILED"
