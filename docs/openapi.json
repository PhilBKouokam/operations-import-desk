                }
              },
              "required": [
                "time",
                "run",
                "attempt",
                "reasonCode",
                "actor"
              ]
            }
          }
        },
        "required": [
          "id",
          "filename",
          "byteSize",
          "state",
          "run",
          "attempt",
          "createdAt",
          "updatedAt",
          "counts",
